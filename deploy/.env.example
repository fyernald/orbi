# Copy this file to ~/orbi/.env on the VPS and fill it in. Never commit the real file.

# Your domain, for example orbi.example.com. Use :80 to test with the server IP before you have a domain (no HTTPS).
DOMAIN=:80

# Database. Make a password with:  openssl rand -hex 24
POSTGRES_USER=orbi
POSTGRES_PASSWORD=
POSTGRES_DB=orbi

# Authentication. Make a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://orbi.example.com

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Orbi <no-reply@orbi.example.com>

# AI service
GEMINI_API_KEY=

# Error monitoring (optional)
SENTRY_DSN=
