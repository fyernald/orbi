# Copy this file to /home/deploy/orbi/.env on the VPS and fill it in. Never commit the real file.

# Database. Make a password with:  openssl rand -hex 24
POSTGRES_USER=orbi
POSTGRES_PASSWORD=
POSTGRES_DB=orbi

# Authentication. Make a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://orbi.study

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Orbi <no-reply@orbi.study>

# AI service
GEMINI_API_KEY=

# Error monitoring (optional)
SENTRY_DSN=
