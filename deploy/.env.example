# Copy this file to /home/orbi/orbi/.env on the VPS and fill it in. Never commit the real file.

# Must stay production: it turns on email confirmation and real email sending.
APP_ENV=production

# Database. Make a password with:  openssl rand -hex 24
POSTGRES_USER=orbi
POSTGRES_PASSWORD=
POSTGRES_DB=orbi

# Authentication. Make a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://orbi.study

# Email (required: sign-up, email confirmation, and password reset send mail).
# Use the SMTP details from your mail provider. Port 587 uses STARTTLS, 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Orbi <no-reply@orbi.study>

# AI providers. A provider's models show in the model menu only when its key is set.
GEMINI_API_KEY=
# Optional
ANTHROPIC_API_KEY=
# Optional
DEEPSEEK_API_KEY=

# How many AI tokens (input and output) each student may use per day.
AI_DAILY_TOKENS_PER_STUDENT=1000000

# Error monitoring (optional). The DSN of the Sentry project, from Settings > Client Keys.
# Empty turns it off for the server. The browser's DSN is the GitHub variable SENTRY_DSN.
SENTRY_DSN=

# Backups (see "Backups" in docs/deployment.md). Days to keep them on the VPS.
BACKUP_KEEP_DAYS=14
# The rclone remote and folder each backup is copied to, so losing the VPS does not lose the data.
BACKUP_REMOTE=orbi-backup:
# Days to keep them there.
BACKUP_REMOTE_KEEP_DAYS=30
