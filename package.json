{
	"name": "orbi",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || exit 0",
		"dev": "pnpm --parallel --filter server --filter client dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@next/eslint-plugin-next": "^16.4.5",
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
