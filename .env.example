# Copy this file to .env and fill in your own values.
# NEVER commit .env or any file with real keys. Only .env.example is committed.

# --- Environment ---
# local: no email confirmation, emails are printed in the server console instead of sent.
# Leave it out (or use production) on the server.
APP_ENV=local

# --- Database (Docker Compose reads these, the server reads DATABASE_URL) ---
POSTGRES_USER=orbi
POSTGRES_PASSWORD=orbi_dev_password
POSTGRES_DB=orbi
# The app runs on your machine (not in Docker), so the host is localhost.
DATABASE_URL=postgresql://orbi:orbi_dev_password@localhost:5432/orbi

# --- Server (Fastify) ---
# The server loads this file by itself (pnpm dev and pnpm start).
SERVER_PORT=3001
HOST=127.0.0.1

# --- Client (Next.js) ---
# Where the client forwards /api/* requests in development.
API_URL=http://localhost:3001

# --- Authentication (required, the server does not start without it) ---
# Make a secret with:  openssl rand -base64 32  (at least 32 characters)
# BETTER_AUTH_URL is the address you open in the browser, not the API.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (not used with APP_ENV=local; Mailpit at http://localhost:8025 if you turn local off) ---
# Sign-up, email confirmation, and password reset send mail. Production also sets SMTP_USER and SMTP_PASSWORD.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Orbi <no-reply@orbi.local>

# --- AI tutor. Server only. A provider's models show in the model menu only when its key is set.
# Without any key the tutor says it is not set up. Gemini: https://aistudio.google.com/
GEMINI_API_KEY=
# Optional. Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional. DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Optional. Only these models are offered, even when other keys are set. Empty offers all.
# For the closed beta: deepseek-flash,deepseek-pro,claude-haiku
AI_ENABLED_MODELS=
# AI usage limits per student, in credits: a token times the model's weight (DeepSeek
# Flash and Claude Haiku 1, DeepSeek Pro 4). The hour and the week start with the first
# AI message. Over a limit, a student can finish with the extra allowance, then waits.
AI_HOURLY_CREDITS=300000
AI_WEEKLY_CREDITS=1500000
AI_GRACE_PERCENT=10
# Every student together. When it is used up, the AI stops for everyone.
AI_TOTAL_CREDITS=80000000

# --- Closed beta (US-50). Without a key nobody can use the app. Default: required in
# production, not with APP_ENV=local. Make keys with: pnpm --filter server keys:create 2
BETA_KEYS_REQUIRED=
# Developers who get in without a key, separated by commas.
ADMIN_EMAILS=
# How many days one key gives. Default 30.
BETA_ACCESS_DAYS=30

# --- Error monitoring (production only, see "Error monitoring" in docs/deployment.md) ---
# The server sends unexpected errors to Sentry when APP_ENV=production and this is set.
# Leave it empty on your computer. The browser's address is the GitHub variable SENTRY_DSN.
SENTRY_DSN=
# Optional. The share of API requests traced for performance, from 0 to 1. Default 0.2.
SENTRY_TRACES_SAMPLE_RATE=
