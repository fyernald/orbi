# Copy this file to .env and fill in your own values.
# NEVER commit .env or any file with real keys. Only .env.example is committed.

# --- Database (Docker Compose reads these, the server reads DATABASE_URL) ---
POSTGRES_USER=orbi
POSTGRES_PASSWORD=orbi_dev_password
POSTGRES_DB=orbi
# The app runs on your machine (not in Docker), so the host is localhost.
DATABASE_URL=postgresql://orbi:orbi_dev_password@localhost:5432/orbi

# --- Server (Fastify) ---
SERVER_PORT=3001
HOST=127.0.0.1

# --- Client (Next.js) ---
# Where the client forwards /api/* requests in development.
API_URL=http://localhost:3001

# --- Authentication (used from US-01) ---
# Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Mailpit catches mail locally, inbox at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Orbi <no-reply@orbi.local>

# --- AI service (used from T-05). Server only. Get a key at https://aistudio.google.com/ ---
GEMINI_API_KEY=

# --- Error monitoring (Sprint 2, optional) ---
SENTRY_DSN=
