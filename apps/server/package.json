	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
		"build": "tsup",
		"start": "node --env-file-if-exists=../../.env --import ./dist/instrument.js dist/index.js",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"keys:create": "tsx --env-file-if-exists=../../.env src/scripts/create-beta-keys.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.106",
		"@ai-sdk/deepseek": "3.0.88",
