{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --noExternal @orbi/core --noExternal @orbi/shared",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orbi/core": "workspace:*",
    "@orbi/shared": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
