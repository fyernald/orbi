		"@fastify/rate-limit": "^11.2.2",
		"@orbi/core": "workspace:*",
		"@orbi/shared": "workspace:*",
		"@sentry/node": "11.14.0",
		"ai": "^7.0.159",
		"better-auth": "^1.7.12",
		"drizzle-orm": "^0.45.4",
		"fastify": "^5.12.8",
		"fastify-type-provider-zod": "^7.0.0",
		"nodemailer": "^10.6.0",
		"pg": "^8.23.1",
		"unpdf": "2.2.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "^4.0.39",
		"@electric-sql/pglite": "^0.5.16",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
